{
  "name": "better-plugins-manager",
  "version": "1.2.23",
  "description": "A more capable plugin manager for Obsidian.",
  "main": "main.js",
  "scripts": {
    "check": "npm run check:types && npm run lint && npm test",
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json package-lock.json",
    "audit:css": "node scripts/audit-css.mjs",
    "lint": "eslint --config eslint.review.mjs . --max-warnings 0",
    "check:types": "tsc --noEmit --skipLibCheck",
    "test": "node --test tests/*.test.mjs"
  },
  "keywords": [],
  "author": "zero",
  "license": "MIT",
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^16.11.6",
    "esbuild": "0.17.3",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "1.14.4",
    "postcss": "^8.5.32",
    "postcss-selector-parser": "^7.1.4",
    "tslib": "2.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "markdown-it": "^14.1.0"
  },
  "allowScripts": {
    "esbuild": true
  },
  "overrides": {
    "obsidian": "$obsidian"
  }
}
